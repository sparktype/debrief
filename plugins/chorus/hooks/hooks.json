{
  "description": "Forward five agent lifecycle events to the installed Chorus.app binary. Prefer `chorus install` so HostInstaller writes absolute paths; bare `chorus` is not on PATH after the menu-bar cutover.",
  "hooks": {
    "SessionStart": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 2}]}],
    "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 2}]}],
    "SubagentStart": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 2}]}],
    "Stop": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 2}]}],
    "SubagentStop": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 2}]}]
  }
}

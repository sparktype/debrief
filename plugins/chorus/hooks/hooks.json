{
  "description": "Forward three start-family lifecycle events to the installed Chorus.app binary. Speech is MCP tool speak (not Stop extraction). Prefer `chorus install` so HostInstaller writes absolute paths. Homebrew puts `chorus` on PATH for install; hooks still call the app binary.",
  "hooks": {
    "SessionStart": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 5}]}],
    "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 5}]}],
    "SubagentStart": [{"matcher": "", "hooks": [{"type": "command", "command": "'/Applications/Chorus.app/Contents/MacOS/chorus' hook --source $([ -n \"${CODEX_HOME:-}\" ] && echo codex || echo claude)", "timeout": 5}]}]
  }
}

#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import tempfile
import time
import urllib.request
from pathlib import Path


def _data_dir() -> Path:
    configured = os.environ.get("CHORUS_DATA_DIR")
    if configured:
        return Path(configured).expanduser()
    return Path.home() / ".local/share/chorus"


def _record_failure(path: Path, source: str, event_name: str, error: Exception) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    record = {"source": source, "event_name": event_name, "error": str(error), "timestamp": time.time()}
    temporary = None
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:
            json.dump(record, handle, ensure_ascii=False)
            handle.write("\n")
            temporary = Path(handle.name)
        os.replace(temporary, path)
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()


def main() -> int:
    source = os.environ.get("CHORUS_HOOK_SOURCE", "unknown")
    event_name = os.environ.get("CHORUS_HOOK_EVENT", "unknown")
    url = os.environ.get("CHORUS_HOOK_URL", "http://127.0.0.1:7777/hooks/events")
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
        if not isinstance(payload, dict):
            payload = {"value": payload}
        body = json.dumps({"source": source, "event_name": event_name, "payload": payload}).encode("utf-8")
        request = urllib.request.Request(url, body, {"Content-Type": "application/json"}, method="POST")
        with urllib.request.urlopen(request, timeout=0.35) as response:
            response.read()
    except Exception as error:
        try:
            _record_failure(_data_dir() / "last_hook_delivery_error.json", source, event_name, error)
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

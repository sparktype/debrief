      "targets": [
        {
          "editorMode": "code",
          "expr": "clamp_min(max(sum by (spark_executor_id) (rate(spark_executor_runtime_ms{cluster=~\"$cluster\", spark_cluster=~\"$spark_cluster\", spark_app_id=~\"$spark_app_id\", spark_job_id=~\"$spark_job_id\"}[$__rate_interval]))), 0) / clamp_min(quantile(0.5, sum by (spark_executor_id) (rate(spark_executor_runtime_ms{cluster=~\"$cluster\", spark_cluster=~\"$spark_cluster\", spark_app_id=~\"$spark_app_id\", spark_job_id=~\"$spark_job_id\"}[$__rate_interval]))), 1)",
          "instant": true,
          "legendFormat": "skew_index",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Skew Index",
      "type": "stat"
    },
